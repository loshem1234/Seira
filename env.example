PORT=3000

# Where the SQLite database file lives. On Railway, point this at a
# mounted persistent volume path, e.g. /data/seira.db
SEIRA_DB_DIR=./data
SEIRA_DB_PATH=./data/seira.db

# Used by lib/diary.js and lib/chat.js. If omitted, the diary falls back
# to a plain listing and chat falls back to a placeholder reply, rather
# than failing outright.
ANTHROPIC_API_KEY=
SEIRA_DIARY_MODEL=claude-sonnet-5
SEIRA_CHAT_MODEL=claude-sonnet-5
