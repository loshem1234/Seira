<header class="seira-topbar">
    <a href="/" class="seira-logo">
        <svg class="seira-sigil" width="26" height="26" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <circle cx="10" cy="14" r="8" stroke="currentColor" stroke-width="0.9" opacity="0.7"/>
            <circle cx="18" cy="14" r="8" stroke="currentColor" stroke-width="0.9" opacity="0.7"/>
            <circle cx="14" cy="14" r="1.6" fill="currentColor"/>
            <line x1="14" y1="14" x2="14" y2="26" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.9"/>
        </svg>
        <span class="seira-logo-text">Seira</span>
    </a>
    <div class="topbar-right">
        <% if (typeof account !== 'undefined' && account) { %>
            <span class="account-email"><%= account.email %></span>
        <% } %>
        <div class="menu-dropdown">
            <button type="button" class="menu-trigger" id="menu-trigger" aria-haspopup="true" aria-expanded="false" title="Menu">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 5.5H17M3 10H17M3 14.5H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
            <div class="menu-panel" id="menu-panel">
                <a href="/dashboard" class="<%= typeof page !== 'undefined' && page === 'dashboard' ? 'active' : '' %>">Dashboard</a>
                <a href="/ledger" class="<%= typeof page !== 'undefined' && page === 'ledger' ? 'active' : '' %>">Ledger</a>
                <a href="/genealogy" class="<%= typeof page !== 'undefined' && page === 'genealogy' ? 'active' : '' %>">Genealogy</a>
                <a href="/archive" class="<%= typeof page !== 'undefined' && page === 'archive' ? 'active' : '' %>">Archive</a>
                <a href="/diary" class="<%= typeof page !== 'undefined' && page === 'diary' ? 'active' : '' %>">Diary</a>
                <div class="menu-divider"></div>
                <form method="POST" action="/logout" class="menu-logout-form">
                    <button type="submit">Logout</button>
                </form>
            </div>
        </div>
    </div>
</header>
<script>
(function () {
    var trigger = document.getElementById('menu-trigger');
    var panel = document.getElementById('menu-panel');
    if (!trigger || !panel) return;
    trigger.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = panel.classList.toggle('open');
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', function () {
        panel.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
    });
})();
</script>
