<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Seira</title>
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
<div class="embers" aria-hidden="true"></div>
<header class="seira-header">
    <h1>✦ Seira</h1>
    <nav class="seira-nav">
        <a href="/" class="<%= page === 'dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/chat" class="<%= page === 'chat' ? 'active' : '' %>">Speak</a>
        <a href="/ledger" class="<%= page === 'ledger' ? 'active' : '' %>">Ledger</a>
        <a href="/genealogy" class="<%= page === 'genealogy' ? 'active' : '' %>">Genealogy</a>
        <a href="/archive" class="<%= page === 'archive' ? 'active' : '' %>">Archive</a>
        <a href="/diary" class="<%= page === 'diary' ? 'active' : '' %>">Diary</a>
        <% if (typeof account !== 'undefined' && account) { %>
            <span class="account-email"><%= account.email %></span>
            <form method="POST" action="/logout" class="logout-form">
                <button type="submit" class="logout-button">Logout</button>
            </form>
        <% } %>
    </nav>
</header>
<main>
