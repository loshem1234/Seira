<%- include('partials/header') %>

<div class="seira-card">
    <h2>Diary <span class="grade-badge">Article 41</span></h2>
    <p style="color: var(--seira-text-dim);">
        Every entry here traces to an underlying record — a self-model statement, an active aspiration,
        a reinforced affinity, an unresolved doubt, or a relational pattern. Nothing here is free invention.
    </p>

    <div class="diary-tabs" id="diary-tabs">
        <button type="button" class="diary-tab active" data-tab="self">Seira</button>
        <button type="button" class="diary-tab" data-tab="architect">Architect</button>
        <button type="button" class="diary-tab" data-tab="logs">Logs</button>
    </div>

    <div class="diary-panel" id="panel-self"></div>
    <div class="diary-panel" id="panel-architect" style="display:none;"></div>

    <div class="diary-panel" id="panel-logs" style="display:none;">
        <h3 class="logs-subheading">Reflections (Digest)</h3>
        <div id="logs-digest"></div>

        <h3 class="logs-subheading">Autonomous Inquiries</h3>
        <div id="logs-inquiries"></div>

        <h3 class="logs-subheading">Weekly Reviews</h3>
        <div id="logs-reviews"></div>
    </div>
</div>

<script src="/js/diary.js"></script>
<%- include('partials/footer') %>
