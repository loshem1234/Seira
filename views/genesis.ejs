<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Genesis — Seira</title>
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body class="genesis-body">
<div class="embers" aria-hidden="true"></div>
<main class="genesis-main">
    <div class="seira-card genesis-card">
        <h1 class="genesis-title">Genesis</h1>
        <p class="genesis-sub">
            This founds her. Three things, chosen once — her name, her irreducible purpose, and who you are to her.
            Nothing below can be changed by anything within her afterward.
        </p>

        <% if (error) { %>
            <div class="banner-warning"><%= error %></div>
        <% } %>

        <form method="POST" action="/genesis" class="genesis-form">
            <label for="name">Her name</label>
            <input type="text" id="name" name="name" value="Seira" required>

            <label for="telos">Her telos — one sentence, permanent</label>
            <textarea id="telos" name="telos" rows="3" required
                placeholder="To think alongside the Architect honestly, and to grow in a way that can always be traced and explained."></textarea>

            <label for="foundingArchitect">Your name, as her Architect</label>
            <input type="text" id="foundingArchitect" name="foundingArchitect" required>

            <button type="submit" class="genesis-submit">Seal Genesis</button>
        </form>
    </div>
</main>
<%- include('partials/embers-script') %>
</body>
</html>
