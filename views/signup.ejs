<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Sign Up — Seira</title>
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body class="genesis-body">
<div class="embers" aria-hidden="true"></div>
<main class="genesis-main">
    <div class="seira-card genesis-card">
        <h1 class="genesis-title">✦ Seira</h1>
        <p class="genesis-sub">Create an account. Your Seira begins the moment you do — founded through her own Genesis, entirely yours.</p>

        <% if (error) { %>
            <div class="banner-warning"><%= error %></div>
        <% } %>

        <form method="POST" action="/signup" class="genesis-form">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required>

            <label for="password">Password</label>
            <input type="password" id="password" name="password" minlength="8" required>

            <button type="submit" class="genesis-submit">Create Account</button>
        </form>
        <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
    </div>
</main>
<%- include('partials/embers-script') %>
</body>
</html>
