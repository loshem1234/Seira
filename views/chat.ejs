<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta charset="UTF-8">
    <title>Seira</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IM+Fell+English+SC&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body class="chat-body">
<div class="embers" aria-hidden="true"></div>
<%- include('partials/topbar') %>

<div class="chat-app">
    <aside class="chat-sidebar" id="chat-sidebar">
        <button type="button" class="new-chat-btn" id="new-chat-btn">+ New Conversation</button>
        <div class="conversation-list" id="conversation-list"></div>
    </aside>

    <button type="button" class="sidebar-toggle" id="sidebar-toggle" title="Toggle conversation list">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3L10.5 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <main class="chat-main">
        <div class="chat-log" id="chat-log"></div>

        <div class="attached-file-indicator" id="attached-file-indicator" style="display:none"></div>

        <form class="chat-input-bar" id="chat-form">
            <div class="input-menu-wrapper">
                <button type="button" class="input-menu-trigger" id="input-menu-trigger" title="Options">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2.5 5H15.5M2.5 9H15.5M2.5 13H15.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </button>
                <div class="input-menu-panel" id="input-menu-panel">
                    <label class="input-menu-item">
                        <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M9.5 2.5L3.8 8.2a2.5 2.5 0 003.5 3.5l5.7-5.7a1.5 1.5 0 00-2.1-2.1L5.2 9.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span>Attach document</span>
                        <input type="file" id="file-input" accept=".txt,.md,.csv,.json,.js,.py,.html,.css,.log" hidden>
                    </label>
                    <div class="input-menu-item input-menu-select-item">
                        <span>Model</span>
                        <select id="model-select"></select>
                    </div>
                    <label class="input-menu-item input-menu-toggle-item">
                        <span>Web search</span>
                        <input type="checkbox" id="websearch-toggle">
                    </label>
                    <label class="input-menu-item input-menu-toggle-item">
                        <span>Contemplation</span>
                        <input type="checkbox" id="contemplation-toggle">
                    </label>
                </div>
            </div>

            <textarea id="chat-input" rows="1" placeholder="Say something…"></textarea>

            <button type="button" class="icon-button" id="mic-btn" title="Voice input">
                <svg width="17" height="17" viewBox="0 0 17 17" fill="none"><rect x="6" y="2" width="5" height="8" rx="2.5" stroke="currentColor" stroke-width="1.3"/><path d="M4 8.5a4.5 4.5 0 009 0M8.5 13v2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            </button>
            <button type="submit" class="icon-button icon-button-send" id="send-btn" title="Send">
                <svg width="17" height="17" viewBox="0 0 17 17" fill="none"><path d="M2 8.5L14.5 3L9.5 15L7.5 9.5L2 8.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
            </button>
        </form>
    </main>
</div>

<script>
    window.SEIRA_NAME = <%- JSON.stringify(seiraName) %>;
    window.SEIRA_TELOS = <%- JSON.stringify(seiraTelos) %>;
</script>
<script src="/js/chat.js"></script>
<%- include('partials/embers-script') %>
</body>
</html>
