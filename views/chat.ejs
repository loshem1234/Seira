<%- include('partials/header') %>

<div class="seira-card chat-card">
    <h2>Speak with <%= seiraName %></h2>
    <div id="chat-log" class="chat-log"></div>
    <form id="chat-form" class="chat-form">
        <input type="text" id="chat-input" placeholder="Say something…" autocomplete="off" required>
        <button type="submit">Send</button>
    </form>
</div>

<script>
(function () {
    const sessionId = localStorage.getItem('seira_session_id') || (function () {
        const id = 'session_' + Date.now() + '_' + Math.random().toString(36).slice(2);
        localStorage.setItem('seira_session_id', id);
        return id;
    })();

    const log = document.getElementById('chat-log');
    const form = document.getElementById('chat-form');
    const input = document.getElementById('chat-input');

    function append(role, text) {
        const div = document.createElement('div');
        div.className = 'chat-message chat-' + role;
        div.textContent = text;
        log.appendChild(div);
        log.scrollTop = log.scrollHeight;
    }

    async function loadHistory() {
        const res = await fetch('/api/chat/' + sessionId + '/history');
        const rows = await res.json();
        rows.forEach(r => append(r.entry_type === 'ingestion' ? 'user' : 'seira', r.content));
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const message = input.value.trim();
        if (!message) return;
        append('user', message);
        input.value = '';
        input.disabled = true;
        try {
            const res = await fetch('/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId, message })
            });
            const data = await res.json();
            append('seira', data.reply || ('Error: ' + data.error));
        } catch (err) {
            append('seira', 'Something went wrong reaching her: ' + err.message);
        } finally {
            input.disabled = false;
            input.focus();
        }
    });

    loadHistory();
})();
</script>

<%- include('partials/footer') %>
